# Environment configuration for chemoinformatics-descriptor-computation
# Fill these in with your real values in .env (do NOT commit .env).
#
# AWS auth: either set the keys below OR use `aws configure` (~/.aws/credentials).
# Never paste access keys into chat, tickets, or git.

AWS_REGION=eu-central-1
# Optional; boto3 also reads AWS_DEFAULT_REGION
# AWS_DEFAULT_REGION=eu-central-1
AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_ACCESS_KEY

# S3: dataset uploads for Batch runs (use S3_BUCKET or AWS_S3_BUCKET)
AWS_S3_BUCKET=your-s3-bucket-name
# S3_PREFIX=chemoinformatics/inputs/

# AWS Batch (use BATCH_* or AWS_BATCH_*)
# Explicit queues for replication studies (recommended):
BATCH_QUEUE_ONDEMAND=chemo-ec2-ondemand-queue
# Job queue ARN (NOT compute-environment ARN):
# arn:aws:batch:eu-central-1:188896658238:job-queue/chemo-ec2-ondemand-queue
# Compute env: chemo-ec2-worker-ondemand (On-Demand EC2, no Spot)
BATCH_QUEUE_SPOT=chemo-ec2-queue
# Legacy single queue (used only if tier-specific queue unset):
AWS_BATCH_JOB_QUEUE=your-batch-job-queue-name
AWS_BATCH_JOB_DEFINITION=your-batch-job-definition-name
# BATCH_JOB_NAME_PREFIX=chemodesc

# Single Google Sheet: Estimates tab (estimator) + Results tab (all real experiments, local and Batch)
GOOGLE_SHEETS_ID=your-google-sheets-id
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/google_service_account.json
# Seconds between each Estimates row append (estimator); avoids Google Sheets 429 quotas
# SHEETS_APPEND_INTERVAL_SEC=2.5

LOG_LEVEL=INFO

